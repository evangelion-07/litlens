# LitLens local backend settings
LITLENS_DATA_DIR=data
LITLENS_DATABASE_PATH=
LITLENS_MAX_UPLOAD_MB=20
LITLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OCR. Requires a separate Tesseract installation; scanned pages may remain unreadable without it.
LITLENS_ENABLE_OCR=true
LITLENS_TESSERACT_PATH=
LITLENS_OCR_LANGUAGE=eng

# Character budget for staged provider-assisted paper analysis.
LITLENS_ANALYSIS_BATCH_CHARS=10000

# Optional Crossref contact email for polite API use.
CROSSREF_MAILTO=

# Optional OpenAI-compatible embedding endpoint. Leave blank for keyword-only retrieval.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional OpenAI-compatible chat-completions endpoint. Leave blank for local extractive answers and reports.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
